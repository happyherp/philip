{
  "name": "philip",
  "version": "0.1.0",
  "private": true,
  "description": "Philip — a guided Bible reading companion (website MVP)",
  "type": "module",
  "scripts": {
    "build:bible": "tsx scripts/build-bible.ts",
    "build:bible:extra": "tsx scripts/build-bible-extra.ts",
    "build:bible:originals": "tsx scripts/build-bible-originals.ts",
    "build:bible:all": "npm run build:bible && npm run build:bible:extra && npm run build:bible:originals",
    "gen:frontend": "tsx scripts/gen-frontend-data.ts",
    "vendor:marked": "tsx scripts/vendor-marked.ts",
    "vendor:preact": "tsx scripts/vendor-preact.ts",
    "dev": "wrangler pages dev public",
    "deploy": "wrangler pages deploy public",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project backend --project frontend",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:watch": "vitest --project backend --project frontend",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.19.19",
    "jsdom": "^25.0.1",
    "serve": "^14.2.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "wrangler": "^4"
  }
}
